# Copy to .env for local use:  cp .env.example .env
# On a host (Render, Railway, Fly...) set these in the dashboard instead; never commit .env.

PORT=3000

# Website URL(s) allowed to connect, comma-separated, no trailing slash.
# Leave empty to allow any origin (testing only).
ALLOWED_ORIGINS=http://localhost:5173

MAX_VIEWERS=20
MAX_ROOMS=200

# Optional: STUN/TURN list as JSON on ONE line. Needed on strict school/office networks.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:HOST:3478","username":"user","credential":"pass"}]
