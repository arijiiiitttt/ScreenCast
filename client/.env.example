# Copy to .env for local use:  cp .env.example .env
# On a static host (Vercel, Netlify, Cloudflare Pages, Render) set this in the dashboard instead.

# Your deployed signaling server (https:// or wss://). Written into config.js by `npm run build`.
# For local dev leave it empty: the page falls back to http://localhost:3000.
SCREENCAST_SERVER=https://screencast-server.onrender.com
